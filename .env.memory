# JVM Memory Configuration for CabinetX Services
# Adjust these values based on your needs

# Small services (notification, configuration, discovery)
SMALL_SERVICE_OPTS="-Xms128m -Xmx256m -XX:MaxMetaspaceSize=128m"

# Medium services (user, patient, clinic, queue, chatbot, analytics)
MEDIUM_SERVICE_OPTS="-Xms256m -Xmx512m -XX:MaxMetaspaceSize=256m"

# Large services (appointment, consultation, medical-record, prescription)
LARGE_SERVICE_OPTS="-Xms512m -Xmx1024m -XX:MaxMetaspaceSize=256m"

# Gateway (handles routing)
GATEWAY_SERVICE_OPTS="-Xms256m -Xmx512m -XX:MaxMetaspaceSize=256m"

# Additional optimization flags
COMMON_OPTS="-XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseStringDeduplication -XX:+OptimizeStringConcat"

# Total expected memory: ~6-8GB for all services
